# ========================================================
# ziiquatic - Uploads Folder Security Hardening
# Strict Sandbox: No script executions or HTML injection
# ========================================================

Options -Indexes -ExecCGI

# 1. Blokir script server (PHP, CGI, Python, Bash, Perl)
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phps|cgi|pl|py|sh|inc|bash|env|htaccess|ini)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# 2. Blokir dokumen web & script klien (Cegah Stored HTML/SVG/JS XSS)
<FilesMatch "(?i)\.(html|htm|shtml|svg|js|json|xml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Matikan modul engine PHP jika diaktifkan
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# 4. Paksa header keamanan pada seluruh file media di folder ini
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
